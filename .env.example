# ==============================================================================
# CREOVO AGENCY CONFIGURATION & ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.
# ==============================================================================

# Resend API Key — server-side only, never exposed to the browser
# Sign up at https://resend.com → API Keys → Create API Key
# Example: re_1234567890abcdef
EMAIL_SERVICE_API_KEY=

# The CREOVO inbox that receives all project enquiries (the RECEIVING address)
# This can be any email — Gmail, custom domain, etc.
# Example: CRE.OVO11@GMAIL.COM
CREOVO_EMAIL=CRE.OVO11@GMAIL.COM

# Resend "From" / sender address.
# Free tier (unverified domain): must use onboarding@resend.dev
# Verified custom domain: use your own, e.g. hello@creovo.agency
# Example (free tier):  CREOVO Inquiries <onboarding@resend.dev>
# Example (custom):     CREOVO Inquiries <hello@creovo.agency>
CREOVO_FROM_EMAIL=CREOVO Inquiries <onboarding@resend.dev>

# CREOVO WhatsApp number with country code, digits only (no +, spaces, dashes)
# Used in server-side logs (non-public)
# Example (India): 917483988674
CREOVO_WHATSAPP_NUMBER=

# Same number with VITE_ prefix so Vite can expose it to the frontend bundle.
# The number is NOT secret — it ends up in public wa.me/ URLs.
# Must match CREOVO_WHATSAPP_NUMBER exactly.
VITE_CREOVO_WHATSAPP_NUMBER=
